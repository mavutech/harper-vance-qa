# Firebase Configuration
# Copy this file to .env (gitignored) or rely on .env.development for local dev.
# REACT_APP_* variables are baked into the build at build time.

REACT_APP_FIREBASE_API_KEY=your-api-key-here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
REACT_APP_FIREBASE_CLIENT_DATABASE_URL=https://your-project-client-data.firebaseio.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:web:abcdef123456
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Analytics stays off unless this flag is explicitly set to true in an
# approved environment after the applicable privacy review.
REACT_APP_ANALYTICS_ENABLED=false

# Enterprise-auth backend (Express app deployed as the sonaDashboard Firebase Function)
REACT_APP_API_BASE_URL=https://us-central1-your-project.cloudfunctions.net/sonaDashboard

# Branded public entry points. Keep relative paths when Firebase Hosting and
# sonaDashboard are deployed in the same project so the browser stays on the
# Harper Vance hostname.
REACT_APP_PUBLIC_ACCESS_URL=/pages/client-access
REACT_APP_REQUEST_ACCESS_URL=/pages/request-access

# Customer-facing role addresses. Configure these mailboxes and verify sender
# authentication before production release.
REACT_APP_SUPPORT_EMAIL=support@harpervanceqa.com
REACT_APP_LEGAL_EMAIL=legal@harpervanceqa.com
REACT_APP_PRIVACY_EMAIL=privacy@harpervanceqa.com
REACT_APP_REPORTS_EMAIL=reports@harpervanceqa.com

# Local enterprise browser certification only. The application fails closed
# unless these values use a demo project and a loopback API.
REACT_APP_USE_FIREBASE_EMULATORS=false
REACT_APP_FIREBASE_EMULATOR_HOST=127.0.0.1
REACT_APP_FIREBASE_AUTH_EMULATOR_PORT=9099
REACT_APP_FIRESTORE_EMULATOR_PORT=8080
REACT_APP_FIREBASE_DATABASE_EMULATOR_PORT=9000
