# Test env — mirrors .env.development so Jest can load firebase/config.js
# without throwing. CRA does not load .env.development during `react-scripts test`.
REACT_APP_FIREBASE_API_KEY=test-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=goldensetups-test.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://goldensetups-test-default-rtdb.firebaseio.com
REACT_APP_FIREBASE_CLIENT_DATABASE_URL=https://goldensetups-test-client-data.firebaseio.com
REACT_APP_FIREBASE_PROJECT_ID=goldensetups-test
REACT_APP_FIREBASE_STORAGE_BUCKET=goldensetups-test.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

REACT_APP_API_BASE_URL=http://localhost:5001/goldensetups-test/us-central1/sonaDashboard
