{
  "hosting": {
    "site": "harpervanceqa-dev",
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/health",
        "function": {
          "functionId": "sonaDashboard",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "sonaDashboard",
          "region": "us-central1"
        }
      },
      {
        "source": "/pages/**",
        "function": {
          "functionId": "sonaDashboard",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
