{
  "hosting": {
    "site": "harpervanceqa-dev",
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/reports/Harper-Vance-Daily-Report-2026-10-12-corrected.pdf",
        "destination": "/#sample",
        "type": 302
      },
      {
        "source": "/reports/Harper-Vance-Daily-Report-2026-10-12-preview.png",
        "destination": "/#evidence",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/health",
        "function": {
          "functionId": "sonaDashboard",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "sonaDashboard",
          "region": "us-central1"
        }
      },
      {
        "source": "/pages/client-access",
        "function": {
          "functionId": "sonaDashboard",
          "region": "us-central1"
        }
      },
      {
        "source": "/pages/request-access",
        "function": {
          "functionId": "sonaDashboard",
          "region": "us-central1"
        }
      },
      {
        "source": "/pages/request-access/verify",
        "function": {
          "functionId": "sonaDashboard",
          "region": "us-central1"
        }
      },
      {
        "source": "/pages/report-request/verify",
        "function": {
          "functionId": "sonaDashboard",
          "region": "us-central1"
        }
      },
      {
        "source": "/pages/client-onboarding",
        "function": {
          "functionId": "sonaDashboard",
          "region": "us-central1"
        }
      },
      {
        "source": "/pages/client-onboarding/payment",
        "function": {
          "functionId": "sonaDashboard",
          "region": "us-central1"
        }
      },
      {
        "source": "/pages/client-applications",
        "function": {
          "functionId": "sonaDashboard",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
